{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexTerm",
  "version": "1.0.0",
  "identifier": "app.nexterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexTerm",
        "width": 1180,
        "height": 740,
        "minWidth": 880,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
